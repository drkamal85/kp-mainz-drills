{
  // Standalone progress-sync Worker. Deploy with:  cd api && npx wrangler deploy
  "name": "kp-progress",
  "main": "progress-worker.js",
  "compatibility_date": "2025-06-01",
  // 1) create the namespace:  npx wrangler kv namespace create PROGRESS
  // 2) paste the printed id below:
  "kv_namespaces": [
    { "binding": "PROGRESS", "id": "85373271ab9841e6b31e4f4795007e7e" }
  ],
  // lock CORS to your site + your app origin (or use "*" while testing):
  "vars": {
    "ALLOWED_ORIGINS": "*"
  }
  // Secrets (DO NOT put here) — set after first deploy:
  //   npx wrangler secret put AUTH_SALT     (recommended; any long random string)
  //   npx wrangler secret put API_TOKENS    (optional; comma-separated allowlist)
}
