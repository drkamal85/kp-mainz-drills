# KP study app (PWA)
/app/*
  Cache-Control: no-cache

# Content pages — always revalidate so updates appear immediately (no stale edge cache)
/index.html
  Cache-Control: no-cache
/flashcards.html
  Cache-Control: no-cache
/reviews/*
  Cache-Control: no-cache
/drills/*
  Cache-Control: no-cache
/summaries/*
  Cache-Control: no-cache
/tools/*
  Cache-Control: no-cache
